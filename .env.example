# Copia este archivo a ".env" (en local) o configura estas mismas variables
# como "Environment Variables" en el panel del servicio donde despliegues
# (Render, Railway, etc.). No subas tu ".env" real a GitHub.

# Obligatoria en producción: cualquier texto largo y aleatorio.
# Si no se define, el servidor genera una al azar en cada arranque, lo que
# desloguea a todos los usuarios cada vez que el servicio reinicia.
SESSION_SECRET=

# Opcional: envío real de correos (HU062). Si se dejan vacías, los correos
# quedan "simulados" (se guardan en el sistema pero no se envían de verdad).
# Con Gmail: activa la verificación en 2 pasos y genera una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords — esa es SMTP_PASS,
# no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=
SMTP_FROM=tu_correo@gmail.com

# La pone automáticamente Render/Railway; no hace falta tocarla.
# PORT=3000
